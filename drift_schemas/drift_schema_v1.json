    {
      "name": "runs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"runs\" (\"id\" TEXT NOT NULL, \"created_at_utc_ms\" INTEGER NOT NULL, \"updated_at_utc_ms\" INTEGER NOT NULL, \"row_revision\" INTEGER NOT NULL DEFAULT 1, \"is_deleted\" INTEGER NOT NULL DEFAULT 0, \"deleted_at_utc_ms\" INTEGER NULL, \"game_id\" TEXT NOT NULL, \"difficulty_id\" TEXT NOT NULL, \"client_run_key\" TEXT NOT NULL, \"started_at_utc_ms\" INTEGER NOT NULL, \"played_on_day\" INTEGER NOT NULL, \"duration_ms\" INTEGER NOT NULL, \"metric_kind\" TEXT NOT NULL, \"metric_value\" INTEGER NOT NULL, \"correct_count\" INTEGER NOT NULL, \"wrong_count\" INTEGER NOT NULL, \"longest_combo\" INTEGER NOT NULL, \"total_reaction_ms\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(game_id) BETWEEN 1 AND 64 AND game_id NOT GLOB '*[^a-z0-9_]*'), CHECK (length(difficulty_id) BETWEEN 1 AND 64 AND difficulty_id NOT GLOB '*[^a-z0-9_]*'), CHECK (length(client_run_key) BETWEEN 1 AND 128 AND client_run_key NOT GLOB '*[^ -~]*'), CHECK (metric_kind IN ('points','duration')), CHECK (started_at_utc_ms > 0), CHECK (duration_ms >= 0), CHECK (metric_value >= 0), CHECK (correct_count >= 0), CHECK (wrong_count >= 0), CHECK (longest_combo >= 0), CHECK (longest_combo <= correct_count), CHECK (total_reaction_ms >= 0), CHECK (is_deleted IN (0,1))) STRICT;"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"id\" TEXT NOT NULL, \"created_at_utc_ms\" INTEGER NOT NULL, \"updated_at_utc_ms\" INTEGER NOT NULL, \"row_revision\" INTEGER NOT NULL DEFAULT 1, \"is_deleted\" INTEGER NOT NULL DEFAULT 0, \"deleted_at_utc_ms\" INTEGER NULL, \"is_sound_enabled\" INTEGER NOT NULL, \"is_haptics_enabled\" INTEGER NOT NULL, \"is_reduce_motion_enabled\" INTEGER NOT NULL, \"is_colour_blind_palette\" INTEGER NOT NULL, \"locale_tag\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (id = 'app'), CHECK (is_sound_enabled IN (0,1)), CHECK (is_haptics_enabled IN (0,1)), CHECK (is_reduce_motion_enabled IN (0,1)), CHECK (is_colour_blind_palette IN (0,1)), CHECK (is_deleted IN (0,1)), CHECK (locale_tag IS NULL OR (length(locale_tag) BETWEEN 2 AND 35 AND locale_tag NOT GLOB '*[^a-z-]*'))) STRICT;"
