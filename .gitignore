# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Golden failure artefacts. flutter_test writes master/test/diff images beside
# the suite when a golden comparison fails; they are debugging output for the
# run that produced them and are meaningless afterwards. A red-proof run
# committed a set of these once.
**/failures/
